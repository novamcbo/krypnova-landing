# Landing-page database (waitlist/leads)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Exion AI / Krypnova Core database. If omitted, the public signals API falls back to DATABASE_URL.
EXION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/KRYPNOVA_CORE_DATABASE

# Optional: restrict public signals to a single Krypnova user ID.
PUBLIC_SIGNALS_USER_ID=

# Resend
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_EMAIL=PedroV@krypnova.com
RESEND_FROM_EMAIL=Krypnova <noreply@krypnova.com>

# Salt for anonymous visitor hashing (public analyze rate limit)
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# Private token for unlimited analyses (creator bypass). Activate in the browser once via /?analyzekey=TOKEN
ANALYZE_BYPASS_TOKEN=change-me-to-a-long-random-string
